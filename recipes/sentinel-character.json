{
  "recipe_version": "0.3.0",
  "id": "sentinel-character-v0",
  "description": "Default non-sacred DAG for the first difficult character proof. Nodes may be replaced or reordered through explicit recipe revisions. Native gates validate state without taking ownership of generative proposal stages.",
  "nodes": [
    {"stage": "intake", "needs": []},
    {"stage": "art_direction", "needs": ["intake"]},
    {"stage": "shape", "needs": ["art_direction"]},
    {"stage": "high_detail", "needs": ["shape"], "native_evidence": "internal-native-preview-v0.1 + semantic detail receipts where applicable"},
    {"stage": "retopology", "needs": ["high_detail"]},
    {"stage": "uv", "needs": ["retopology"], "native_gate": "internal-native-uv-v0.1"},
    {"stage": "bake", "needs": ["high_detail", "uv"]},
    {"stage": "materials", "needs": ["bake", "art_direction"], "native_support": "internal-native-pbr-v0.1"},
    {"stage": "rig", "needs": ["retopology"], "native_gate": "internal-native-skin-v0.1:skeleton"},
    {"stage": "skinning", "needs": ["rig", "retopology"], "native_gate": "internal-native-skin-v0.1:weights+bind_pose+deformation"},
    {"stage": "animation", "needs": ["skinning"], "native_gate": "internal-native-animation-v0.1:pose+contact_drift"},
    {"stage": "secondary_motion", "needs": ["skinning", "materials"]},
    {"stage": "facial", "needs": ["skinning", "materials"], "native_gate": "internal-native-morph-v0.1"},
    {"stage": "vfx", "needs": ["rig", "materials"]},
    {"stage": "lod", "needs": ["materials", "skinning"], "native_support": "internal-native-attribute-lod-v0.1 + internal-native-character-lod-proof-v0.1", "truth_limit": "An experimental path now carries UV/skin/morph attributes and measures posed deformation loss. It remains blocked for final Sentinel delivery until the real Sentinel mesh passes declared deformation, silhouette/material retention and in-engine transition gates."},
    {"stage": "collision", "needs": ["retopology", "rig"], "native_support": "internal-native-geometry-v0.1:aabb_only"},
    {"stage": "engine_pack", "needs": ["animation", "secondary_motion", "facial", "vfx", "lod", "collision"], "native_support": "internal-native-character-gltf-v0.1"},
    {"stage": "in_game_validation", "needs": ["engine_pack"]},
    {"stage": "canonize", "needs": ["in_game_validation"]}
  ]
}
