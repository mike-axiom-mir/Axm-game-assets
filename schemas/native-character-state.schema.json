{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/native-character-state.schema.json",
  "title": "AXM Native Character State v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "asset_id", "skeleton", "skin"],
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "vec4": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 4,
      "maxItems": 4
    },
    "joint4": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0},
      "minItems": 4,
      "maxItems": 4
    }
  },
  "properties": {
    "schema": {"const": "axm.game-assets.character-state.v0.1"},
    "asset_id": {"type": "string", "minLength": 1},
    "skeleton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["joints"],
      "properties": {
        "joints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "parent": {"type": ["integer", "null"], "minimum": 0},
              "translation": {"$ref": "#/$defs/vec3"},
              "rotation": {"$ref": "#/$defs/vec4"},
              "scale": {"$ref": "#/$defs/vec3"}
            }
          }
        }
      }
    },
    "skin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["joints", "weights"],
      "properties": {
        "joints": {"type": "array", "items": {"$ref": "#/$defs/joint4"}},
        "weights": {"type": "array", "items": {"$ref": "#/$defs/vec4"}}
      }
    },
    "morph_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "position_deltas"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "position_deltas": {"type": "array", "items": {"$ref": "#/$defs/vec3"}},
          "normal_deltas": {"type": "array", "items": {"$ref": "#/$defs/vec3"}}
        }
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "tracks"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "tracks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["joint", "path", "times", "values"],
              "properties": {
                "joint": {"type": "integer", "minimum": 0},
                "path": {"enum": ["translation", "rotation", "scale"]},
                "times": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
                "values": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": "number"}}},
                "interpolation": {"enum": ["LINEAR", "STEP"], "default": "LINEAR"}
              }
            }
          }
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "animation", "vertices", "sample_times", "max_drift"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "animation": {"type": "string", "minLength": 1},
          "vertices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
          "sample_times": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
          "max_drift": {"type": "number", "minimum": 0}
        }
      }
    },
    "provenance": {"type": "object"}
  }
}
