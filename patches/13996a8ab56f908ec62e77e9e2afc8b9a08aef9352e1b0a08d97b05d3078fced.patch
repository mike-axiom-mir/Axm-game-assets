+
+    def test_source_first_uc_ingress_rejects_tampered_glb(self) -> None:
+        with tempfile.TemporaryDirectory() as td:
+            root = Path(td)
+            asset = root / "asset.glb"
+            body = _glb()
+            asset.write_bytes(body)
