+                "schema": "axm.creator-source/v1",
+                "kind": "form-pattern",
+                "source_authority": True,
+                "realization_is_secondary": True,
+                "automatic_canon_admission": False,
+                "artifact": {
+                    "path": "/provider/asset.glb",
+                    "sha256": hashlib.sha256(body).hexdigest(),
+                    "specification_sha256": "2" * 64,
