+#!/usr/bin/env python3
+"""Native found-object/detail vocabulary for dense Game Asset Forge assets.
+
+Selectively adapted from the finished Universal Creation RTS/workshop foundry at
+commit ``a5cc708457b7e8f33e794fdac648ae65d15a0fb4``. The donor mechanisms are
+``tools/blender/axm_salvage_personality.py`` and the generic detail ideas in
+``src/axm_uc/rts_detail.py``.
+
+These functions author real, inspectable geometry for small semantic details.
+They do not choose art direction or claim that more clutter automatically means
+better art. Placement remains an authored/caller decision.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from dataclasses import dataclass
+from typing import Any, Iterable, Sequence
+
+from native_construction_kit import (
+    SemanticPart,
+    beam_segment,
+    build_crate,
+    lathe_profile,
+    pipe_path,
+    rounded_box,
+    torus_ring,
+)
+from native_geometry import Mesh, combine, make_uv_sphere, scale, topology_report, translate
+
+SCHEMA = "axm.game-assets.found-object-detail/v0.1"
+DONOR = {
+    "repo": "mike-axiom-mir/axm-universal-creation",
+    "commit": "a5cc708457b7e8f33e794fdac648ae65d15a0fb4",
+    "mechanisms": ["tools/blender/axm_salvage_personality.py", "src/axm_uc/rts_detail.py"],
+}
+
+
+class FoundObjectDetailError(ValueError):
+    pass
+
+
+@dataclass(frozen=True, slots=True)
+class PracticalLight:
+    name: str
+    position: tuple[float, float, float]
+    color_hint: tuple[float, float, float]
+    energy_hint: float
+    radius_hint: float
+    note: str = "Render practical metadata only; target engine must recreate and tune the light."
+
+
+@dataclass(frozen=True, slots=True)
+class DetailCluster:
+    name: str
+    parts: tuple[SemanticPart, ...]
+    practical_lights: tuple[PracticalLight, ...]
+    receipt: dict[str, Any]
+
+    def combined_mesh(self) -> Mesh:
+        return combine((part.mesh for part in self.parts), name=self.name)
+
+
+def _canonical(value: Any) -> bytes:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False).encode("utf-8")
+
+
+def _digest(value: Any) -> str:
+    return "sha256:" + hashlib.sha256(_canonical(value)).hexdigest()
+
+
+def _mesh_digest(mesh: Mesh) -> str:
+    return _digest({"name": mesh.name, "vertices": mesh.vertices, "faces": mesh.faces})
+
+
+def _finite3(value: Sequence[float], label: str) -> tuple[float, float, float]:
+    if len(value) != 3:
+        raise FoundObjectDetailError(f"{label} must contain three values")
+    result = tuple(float(item) for item in value)
+    if not all(math.isfinite(item) for item in result):
+        raise FoundObjectDetailError(f"{label} must contain finite values")
+    return result  # type: ignore[return-value]
+
+
+def _positive(value: float, label: str) -> float:
+    value = float(value)
+    if not math.isfinite(value) or value <= 0:
+        raise FoundObjectDetailError(f"{label} must be finite and positive")
+    return value
+
+
+def _part(part_id: str, mesh: Mesh, material: str, role: str) -> SemanticPart:
+    report = topology_report(mesh)
+    if report["invalid_indices"] or report["degenerate_faces"] or not report["closed_two_manifold_candidate"]:
+        raise FoundObjectDetailError(f"detail part {part_id!r} is not a valid closed shell: {report}")
+    return SemanticPart(part_id, mesh, material, role)
+
+
+def _cluster(name: str, parts: Iterable[SemanticPart], recipe: str, lights: Iterable[PracticalLight] = ()) -> DetailCluster:
+    ordered = tuple(parts)
+    practical = tuple(lights)
+    if not ordered:
+        raise FoundObjectDetailError("detail cluster must contain geometry")
+    ids = [part.part_id for part in ordered]
+    if len(ids) != len(set(ids)):
+        raise FoundObjectDetailError("detail part ids must be unique")
+    for light in practical:
+        _finite3(light.position, f"light {light.name} position")
+        _finite3(light.color_hint, f"light {light.name} color")
+        _positive(light.energy_hint, f"light {light.name} energy")
+        _positive(light.radius_hint, f"light {light.name} radius")
+    receipt: dict[str, Any] = {
+        "schema": SCHEMA,
+        "name": name,
+        "recipe": recipe,
+        "coordinate_system": "Y-up",
+        "parts": [
+            {
+                "part_id": part.part_id,
+                "material_family": part.material_family,
+                "semantic_role": part.semantic_role,
+                "mesh_digest": _mesh_digest(part.mesh),
+                "topology": topology_report(part.mesh),
+            }
+            for part in ordered
+        ],
+        "practical_lights": [
+            {
+                "name": light.name,
+                "position": list(light.position),
+                "color_hint": list(light.color_hint),
+                "energy_hint": light.energy_hint,
+                "radius_hint": light.radius_hint,
+                "note": light.note,
+            }
+            for light in practical
+        ],
+        "provenance": {"donor": DONOR, "implementation": "AXM Game Asset Forge native detail adaptation"},
+        "truth_boundary": {
+            "authored_geometry": True,
+            "light_metadata_is_engine_light": False,
+            "aesthetic_quality_proven": False,
+            "automatic_detail_placement": False,
+            "automatic_genome_mutation": False,
+            "automatic_canon": False,
+        },
+    }
+    receipt["receipt_digest"] = _digest(receipt)
+    return DetailCluster(name, ordered, practical, receipt)
+
+
+def _ellipsoid(name: str, center: Sequence[float], size: Sequence[float]) -> Mesh:
+    c = _finite3(center, "ellipsoid center")
+    if len(size) != 3:
+        raise FoundObjectDetailError("ellipsoid size must contain three values")
+    sx, sy, sz = (_positive(value, f"ellipsoid size[{index}]") for index, value in enumerate(size))
+    sphere = make_uv_sphere(1.0, segments=20, rings=10, name=name)
+    return translate(scale(sphere, (sx, sy, sz), name=name), c, name=name)
+
+
+def build_kettle(
+    *,
+    name: str = "kettle",
+    center: Sequence[float] = (0.0, 0.0, 0.0),
+    size: float = 1.0,
+) -> DetailCluster:
+    c = _finite3(center, "center")
+    s = _positive(size, "size")
+    x, y, z = c
+    parts = [
+        _part("body", _ellipsoid(f"{name}-body", (x, y + .13 * s, z), (.16 * s, .14 * s, .13 * s)), "salvage_metal", "enamel-body"),
+        _part("lid", lathe_profile(((0, 0), (.10 * s, .004 * s), (.10 * s, .025 * s), (0, .025 * s)), center=(x, y + .25 * s, z), segments=20, name=f"{name}-lid"), "steel", "lid"),
+        _part("lid-knob", _ellipsoid(f"{name}-knob", (x, y + .31 * s, z), (.035 * s, .035 * s, .035 * s)), "wood", "lid-knob"),
+        _part("spout", pipe_path(((x + .10*s, y + .10*s, z), (x + .21*s, y + .18*s, z), (x + .25*s, y + .26*s, z)), radius=.032*s, sides=8, name=f"{name}-spout"), "salvage_metal", "spout"),
+        _part("handle", pipe_path(((x - .10*s, y + .20*s, z), (x - .11*s, y + .39*s, z), (x + .10*s, y + .39*s, z), (x + .10*s, y + .20*s, z)), radius=.020*s, sides=7, name=f"{name}-handle"), "steel", "carry-handle"),
+    ]
+    return _cluster(name, parts, "kettle")
+
+
+def build_mug(
+    *,
+    name: str = "mug",
+    center: Sequence[float] = (0.0, 0.0, 0.0),
+    size: float = 1.0,
+) -> DetailCluster:
+    c = _finite3(center, "center")
+    s = _positive(size, "size")
+    x, y, z = c
+    body = lathe_profile(((0, 0), (.055*s, .002*s), (.058*s, .13*s), (0, .13*s)), center=c, segments=18, name=f"{name}-body")
+    handle = torus_ring((x + .061*s, y + .072*s, z), radius=.034*s, tube=.009*s, axis="x", major_segments=16, minor_segments=6, name=f"{name}-handle")
+    parts = [
+        _part("body", body, "salvage_metal", "mug-body"),
+        _part("handle", handle, "salvage_metal", "mug-handle"),
+    ]
+    return _cluster(name, parts, "mug")
+
+
+def build_winch(
+    *,
+    name: str = "winch",
+    center: Sequence[float] = (0.0, 0.0, 0.0),
+    radius: float = .22,
+    cable_drop: float = .9,
+) -> DetailCluster:
+    c = _finite3(center, "center")
+    radius = _positive(radius, "radius")
+    cable_drop = _positive(cable_drop, "cable_drop")
+    x, y, z = c
+    parts: list[SemanticPart] = [
+        _part("wheel", torus_ring(c, radius=radius, tube=radius*.16, axis="z", major_segments=24, minor_segments=7, name=f"{name}-wheel"), "salvage_metal", "reused-winch-wheel")
+    ]
+    for index, angle in enumerate((0.0, math.tau/3, math.tau*2/3)):
+        end = (x + radius*.92*math.cos(angle), y + radius*.92*math.sin(angle), z)
+        parts.append(_part(f"spoke-{index}", beam_segment(c, end, width=radius*.07, depth=radius*.07, name=f"{name}-spoke"), "steel", "winch-spoke"))
+    path = ((x, y, z), (x + .08, y - cable_drop*.45, z), (x + .14, y - cable_drop, z))
+    parts.append(_part("cable", pipe_path(path, radius=max(.008, radius*.055), sides=6, name=f"{name}-cable"), "rubber", "drop-cable"))
+    return _cluster(name, parts, "winch")
+
+
+def build_stool(
+    *,
+    name: str = "stool",
+    center: Sequence[float] = (0.0, 0.0, 0.0),
+    seat_radius: float = .20,
+    height: float = .72,
+) -> DetailCluster:
+    c = _finite3(center, "center")
+    r = _positive(seat_radius, "seat_radius")
+    height = _positive(height, "height")
+    x, y, z = c
+    parts: list[SemanticPart] = []
+    for index, (dx, dz) in enumerate(((-.55, -.35), (.55, -.35), (0, .55))):
+        start = (x + dx*r*1.15, y, z + dz*r*1.15)
+        end = (x + dx*r*.72, y + height*.92, z + dz*r*.72)
+        parts.append(_part(f"leg-{index}", beam_segment(start, end, width=r*.12, depth=r*.12, name=f"{name}-leg"), "wood", "reused-leg"))
+    seat = lathe_profile(((0,0),(r,0),(r,height*.09),(0,height*.09)), center=(x, y + height*.91, z), segments=24, name=f"{name}-seat")
+    parts.append(_part("seat", seat, "salvage_metal", "hubcap-seat"))
+    return _cluster(name, parts, "stool")
+
+
+def build_lantern(
+    *,
+    name: str = "lantern",
+    center: Sequence[float] = (0.0, 0.0, 0.0),
+    size: float = 1.0,
+    practical_light: bool = True,
+) -> DetailCluster:
+    c = _finite3(center, "center")
+    s = _positive(size, "size")
+    x, y, z = c
+    core = lathe_profile(((0,0),(.09*s,0),(.09*s,.29*s),(0,.29*s)), center=(x,y-.145*s,z), segments=18, name=f"{name}-core")
+    parts: list[SemanticPart] = [_part("core", core, "glass", "luminous-glass-envelope")]
+    for index, (dy, radius) in enumerate(((-.19,.13),(-.16,.105),(.17,.14),(.21,.10))):
+        cap = lathe_profile(((0,0),(radius*s,0),(radius*s,.035*s),(0,.035*s)), center=(x,y+dy*s,z), segments=18, name=f"{name}-cap")
+        parts.append(_part(f"cap-{index}", cap, "steel", "lantern-cap"))
+    for index, angle in enumerate((0, math.pi/2, math.pi, math.pi*1.5)):
+        dx=.105*s*math.cos(angle); dz=.105*s*math.sin(angle)
+        cage = beam_segment((x+dx,y-.17*s,z+dz),(x+dx,y+.18*s,z+dz),width=.018*s,depth=.018*s,name=f"{name}-cage")
+        parts.append(_part(f"cage-{index}", cage, "steel", "lantern-cage"))
+    handle = torus_ring((x,y+.33*s,z),radius=.065*s,tube=.010*s,axis="z",major_segments=18,minor_segments=6,name=f"{name}-handle")
+    parts.append(_part("handle", handle, "steel", "lantern-handle"))
+    lights: tuple[PracticalLight, ...] = ()
+    if practical_light:
+        lights = (PracticalLight(f"{name}-practical", (x,y,z), (1.0,.48,.14), 75.0*s, .13*s),)
+    return _cluster(name, parts, "lantern", lights)
+
+
+def build_tied_cargo(
+    *,
+    name: str = "cargo",
+    center: Sequence[float] = (0.0, 0.0, 0.0),
+    size: float = 1.0,
+) -> DetailCluster:
+    c = _finite3(center, "center")
+    s = _positive(size, "size")
+    crate = build_crate(name=f"{name}-crate", center=c, size=(.9*s,.65*s,.62*s))
+    parts = [SemanticPart(f"crate:{part.part_id}", part.mesh, part.material_family, part.semantic_role) for part in crate.parts]
+    x,y,z=c
+    for index, dx in enumerate((-.28*s,.28*s)):
+        path=((x+dx,y-.31*s,z+.34*s),(x+dx,y+.37*s,z+.34*s),(x+dx,y+.37*s,z-.34*s),(x+dx,y-.31*s,z-.34*s))
+        parts.append(_part(f"rope-{index}", pipe_path(path,radius=.018*s,sides=6,name=f"{name}-rope"),"cloth","cargo-binding"))
+    return _cluster(name, parts, "tied-cargo")
