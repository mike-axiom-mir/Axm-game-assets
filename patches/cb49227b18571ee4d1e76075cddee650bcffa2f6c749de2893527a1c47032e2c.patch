+    rows.append((
+        torus_ring((.115,pelvis[1]-.072,hi[2]+.052),radius=.030,tube=.007,axis="z",major_segments=16,minor_segments=5,name="kettlejack-v2-belt-ring"),
+        "pelvis","steel","tool-belt-ring"
