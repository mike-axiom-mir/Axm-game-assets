+def _write_materials(root: Path, texture_size: int) -> dict[str, dict[str, str]]:
+    textures = root / "textures"
+    outputs: dict[str, dict[str, str]] = {}
+    skin_dir = textures / "skin"
+    skin = write_skin_material(
+        skin_dir,
+        size=texture_size,
+        seed=1717,
+        spec=SkinMaterialSpec(base_rgb=(190,137,105), undertone_rgb=(158,82,67), freckle_density=.055),
+    )
+    outputs["skin"] = {
+        "base_color": "textures/skin/base_color.png",
+        "normal": "textures/skin/normal.png",
+        "orm": "textures/skin/orm.png",
+        "manifest": str(skin["manifest_sha256"]),
+    }
+
+    for index, (name, recipe) in enumerate(MATERIAL_RECIPES.items()):
+        if name == "skin":
+            continue
+        kind = str(recipe["kind"])
+        target = textures / name
+        manifest = write_surface_family(
+            target,
+            kind=kind,
+            size=texture_size,
+            seed=2200 + index * 97,
+            name=f"kettlejack-{name}",
+            base_rgb=recipe["base_rgb"],
+            scale=1.15 if kind in {"cloth","wood"} else 1.0,
+        )
+        outputs[name] = {
+            "base_color": f"textures/{name}/base_color.png",
+            "normal": f"textures/{name}/normal.png",
+            "orm": f"textures/{name}/orm.png",
+            "manifest": str(manifest["manifest_digest"]),
+        }
+    return outputs
+
