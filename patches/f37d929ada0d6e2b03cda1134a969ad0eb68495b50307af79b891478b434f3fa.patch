+def _sha(data: bytes) -> str:
+    return "sha256:" + hashlib.sha256(data).hexdigest()
+
+
+def _sha_file(path: Path) -> str:
+    return _sha(path.read_bytes())
+
+
+def _smooth(edge0: float, edge1: float, value: float) -> float:
+    if edge1 <= edge0:
+        return 0.0
+    t = max(0.0, min(1.0, (value - edge0) / (edge1 - edge0)))
+    return t * t * (3.0 - 2.0 * t)
+
+
+def stylize_body(source: Mesh) -> tuple[Mesh, dict[str, Any]]:
+    """Apply a bounded, topology-preserving stylization before rig derivation."""
+    lo, hi = bounds(source)
+    height = hi[1] - lo[1]
+    center_z = (lo[2] + hi[2]) * 0.5
+    vertices = []
+    max_head_scale = 1.0
+    for x, y, z in source.vertices:
+        t = (y - lo[1]) / max(height, 1e-12)
+        head = _smooth(0.82, 0.95, t)
+        torso = _smooth(0.48, 0.70, t) * (1.0 - _smooth(0.82, 0.90, t))
+        lower = 1.0 - _smooth(0.42, 0.56, t)
+        x_scale = 1.0 + 0.22 * head + 0.035 * torso - 0.035 * lower
+        z_scale = 1.0 + 0.18 * head + 0.025 * torso
+        max_head_scale = max(max_head_scale, 1.0 + 0.22 * head)
+        vertices.append((x * x_scale, y, center_z + (z - center_z) * z_scale))
+    mesh = Mesh("kettlejack_stylized_hm08_source", vertices, list(source.faces))
+    report = topology_report(mesh)
+    if report["invalid_indices"] or report["degenerate_faces"]:
+        raise ValueError(f"stylization damaged topology: {report}")
+    return mesh, {
+        "method": "bounded topology-preserving regional x/z scaling",
+        "source_height_m": height,
+        "maximum_head_width_scale": max_head_scale,
+        "topology": report,
+        "truth": "Authored stylization from Kettlejack design intent; not image-reconstructed geometry.",
+    }
+
+
+def _scale_skeleton(skeleton: Skeleton, factor: float, ground_offset: float) -> Skeleton:
+    joints = []
+    for joint in skeleton.joints:
+        tx, ty, tz = joint.translation
+        translation = (tx * factor, ty * factor, tz * factor)
+        if joint.parent is None:
+            translation = (translation[0], translation[1] + ground_offset, translation[2])
+        joints.append(replace(joint, translation=translation))
+    result = Skeleton(joints)
+    report = validate_skeleton(result)
+    if report["status"] != "pass":
+        raise ValueError(f"scaled skeleton invalid: {report}")
+    return result
+
+
+def _scaled_point(point: tuple[float, float, float], factor: float, ground_offset: float):
+    return point[0] * factor, point[1] * factor + ground_offset, point[2] * factor
+
+
+def _qmul(a, b):
+    ax, ay, az, aw = a
+    bx, by, bz, bw = b
+    return (
+        aw*bx + ax*bw + ay*bz - az*by,
+        aw*by - ax*bz + ay*bw + az*bx,
+        aw*bz + ax*by - ay*bx + az*bw,
+        aw*bw - ax*bx - ay*by - az*bz,
+    )
+
+
+def _pose_quat(*, x: float = 0.0, y: float = 0.0, z: float = 0.0):
+    q = (0.0, 0.0, 0.0, 1.0)
+    for axis, angle in (((1.0,0.0,0.0), x), ((0.0,1.0,0.0), y), ((0.0,0.0,1.0), z)):
+        if abs(angle) > 1e-12:
+            q = _qmul(q, axis_angle_quaternion(axis, angle))
+    length = math.sqrt(sum(v*v for v in q))
+    return tuple(v/length for v in q)
+
+
+def _rot_track(index: int, times: list[float], poses: list[dict[str, float]]) -> AnimationTrack:
+    return AnimationTrack(index, "rotation", times, [_pose_quat(**pose) for pose in poses])
