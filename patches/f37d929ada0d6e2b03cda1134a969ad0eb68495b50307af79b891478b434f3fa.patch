+def _group_accessories(rows: Iterable[tuple[Mesh,str,str,str]]):
+    grouped: dict[tuple[str,str], dict[str, Any]] = {}
+    for mesh, joint, family, role in rows:
+        key=(joint,family)
+        bucket=grouped.setdefault(key,{"meshes":[],"roles":[]})
+        bucket["meshes"].append(mesh)
+        bucket["roles"].append(role)
+    result=[]
+    for (joint,family), bucket in sorted(grouped.items()):
+        mesh=combine(bucket["meshes"],name=f"kettlejack-{joint}-{family}")
+        result.append((mesh,joint,family,"+".join(sorted(set(bucket["roles"])))))
+    return result
+
+
+def write_kettlejack_package(
+    output: str | Path,
+    *,
+    texture_size: int = 64,
+    target_height_m: float = TARGET_HEIGHT_M,
+) -> dict[str, Any]:
+    root=Path(output)
+    root.mkdir(parents=True,exist_ok=True)
+    if any(root.iterdir()):
+        raise FileExistsError(f"Kettlejack output must start empty: {root}")
+    if not 1.15 <= target_height_m <= 1.60:
+        raise ValueError("Kettlejack target height must stay within [1.15,1.60] m")
+
+    source_body, body_uv, target_state = _load_identity_body()
+    styled, stylization = stylize_body(source_body)
+    if validate_uv(styled, body_uv)["status"] != "pass":
+        raise ValueError("stylized body UV state invalid")
+
+    skeleton, rig_evidence, name_to_index = build_hm08_humanoid_skeleton(styled)
+    landmarks = derive_hm08_rig_landmarks(styled)
+    body_weights, skin_evidence = build_hm08_skin_weights_v2(styled, skeleton, landmarks, name_to_index)
+
+    undersuit, undersuit_uv, undersuit_evidence = build_hm08_undersuit(styled, body_uv)
+    undersuit_weights, undersuit_skin_evidence = build_hm08_skin_weights_v2(
+        undersuit, skeleton, landmarks, name_to_index
+    )
+
+    lo, hi=bounds(styled)
+    source_height=hi[1]-lo[1]
+    factor=target_height_m/source_height
+    scaled_body=scale(styled,factor,name="kettlejack-body")
+    scaled_undersuit=scale(undersuit,factor,name="kettlejack-outfit")
+    scaled_lo,_scaled_hi=bounds(scaled_body)
+    ground_offset=-scaled_lo[1]
+    body=translate(scaled_body,(0.0,ground_offset,0.0),name="kettlejack-body")
+    outfit=translate(scaled_undersuit,(0.0,ground_offset,0.0),name="kettlejack-outfit")
+    scaled_skeleton=_scale_skeleton(skeleton,factor,ground_offset)
+    scaled_landmarks={
+        name:_scaled_point(point,factor,ground_offset)
+        for name,point in landmarks.items()
+    }
+    grounded_lo,grounded_hi=bounds(body)
+    actual_height=grounded_hi[1]-grounded_lo[1]
+    if abs(actual_height-target_height_m)>1e-9 or abs(grounded_lo[1])>1e-9:
+        raise ValueError("target scale/grounding drifted")
+
+    materials=_write_materials(root,texture_size)
+
+    primitives=[
+        SkinnedMaterialPrimitive(
+            body,body_uv,body_weights,
+            "Kettlejack_Skin",
+            materials["skin"]["base_color"],materials["skin"]["normal"],materials["skin"]["orm"],
+            metallic_factor=0.0,roughness_factor=1.0,semantic_role="body-and-face",
+        ),
+        SkinnedMaterialPrimitive(
+            outfit,undersuit_uv,undersuit_weights,
+            "Kettlejack_Patched_Outfit",
+            materials["outfit"]["base_color"],materials["outfit"]["normal"],materials["outfit"]["orm"],
+            metallic_factor=0.0,roughness_factor=1.0,double_sided=True,semantic_role="patched-work-clothes",
+        ),
+    ]
+
+    accessory_rows=_accessory_meshes(scaled_landmarks,body)
+    grouped=_group_accessories(accessory_rows)
+    accessory_evidence=[]
+    for mesh,joint_name,family,role in grouped:
+        uv=box_project_world(mesh,world_units_per_tile=.14)
+        uv_report=validate_uv(mesh,uv)
+        topology=topology_report(mesh)
+        if uv_report["status"]!="pass" or topology["invalid_indices"] or topology["degenerate_faces"]:
+            raise ValueError(f"accessory {role} invalid: uv={uv_report} topology={topology}")
+        joint=name_to_index[joint_name]
+        primitive=SkinnedMaterialPrimitive(
+            mesh,uv,rigid_skin_weights(mesh,joint),
+            f"Kettlejack_{family}_{joint_name}",
+            materials[family]["base_color"],materials[family]["normal"],materials[family]["orm"],
+            metallic_factor=METALLIC_FACTORS[family],
+            roughness_factor=1.0,
+            semantic_role=role,
+        )
+        primitives.append(primitive)
+        accessory_evidence.append({
+            "mesh":mesh.name,"joint":joint_name,"joint_index":joint,"material_family":family,
+            "semantic_role":role,"topology":topology,"uv":uv_report,
+        })
+
+    clips=build_kettlejack_clips(name_to_index)
+    clip_evidence=[]
+    for clip in clips:
+        report=validate_animation_clip(clip,scaled_skeleton)
+        if report["status"]!="pass":
+            raise ValueError(f"Kettlejack clip {clip.name} invalid: {report}")
+        clip_evidence.append({"name":clip.name,**report})
+
+    delivery=write_skinned_multi_gltf(primitives,scaled_skeleton,root,clips,name=ASSET_NAME)
+
+    package: dict[str, Any]={
+        "schema":SCHEMA,
+        "asset_id":"kettlejack",
+        "asset_name":"Kettlejack",
+        "candidate_role":"animated_game_character_proving_asset",
+        "design_intent":DESIGN_INTENT,
+        "height_m":actual_height,
+        "ground_y_m":grounded_lo[1],
+        "source":{
+            "substrate":"seed_data/hm08_full_body_v0.1",
+            "identity_target_state":target_state,
+            "canonical_source_mutated":False,
+        },
+        "stylization":stylization,
+        "rig":rig_evidence,
+        "skin":skin_evidence,
+        "outfit":{"construction":undersuit_evidence,"skin":undersuit_skin_evidence},
+        "clips":clip_evidence,
+        "accessories":accessory_evidence,
+        "materials":materials,
+        "delivery":delivery,
+        "acceptance":{
+            "target_height_grounded":abs(actual_height-target_height_m)<=1e-9 and abs(grounded_lo[1])<=1e-9,
+            "skeleton_valid":validate_skeleton(scaled_skeleton)["status"]=="pass",
+            "five_authored_clips":len(clips)==5,
+            "multi_material_character":delivery["primitive_count"]>=8,
+            "structural_gltf":delivery["validation"]["status"]=="pass",
+            "required_design_features_present":all(any(
+                needle in row["semantic_role"] for row in accessory_evidence
+            ) for needle in ("scarf","tool-belt","goggle","hubcap","kettle-pack","mechanical-leg","wrench")),
+        },
+        "truth":{
+            "real_3d_geometry":True,
+            "real_skeleton":True,
+            "real_skin_weights":True,
+            "real_animation_tracks":True,
+            "real_multi_material_gltf":True,
+            "concept_pixel_faithful":False,
+            "visual_match_proven":False,
+            "production_deformation_proven":False,
+            "engine_import_proven_in_this_build":False,
+            "automatic_genome_mutation":False,
+            "automatic_release":False,
+            "automatic_canon":False,
+            "notes":[
+                "The generated concept is a design target; no unsupported image-to-hidden-geometry claim is made.",
+                "Rigid accessories use explicit one-joint skinning so they follow the shared skeleton while staying structurally inspectable.",
+                "No finger chains, cloth simulation, facial animation, gameplay controller, or final art acceptance is claimed in v0.1.",
+            ],
+        },
+    }
+    if not all(package["acceptance"].values()):
+        raise ValueError(f"Kettlejack acceptance failed: {package['acceptance']}")
+
+    files={}
+    for path in sorted(root.rglob("*")):
+        if path.is_file() and path.name!="kettlejack-package.json":
+            files[path.relative_to(root).as_posix()]=_sha_file(path)
+    package["files"]=files
+    payload=(json.dumps(package,indent=2,sort_keys=True,ensure_ascii=False)+"\n").encode("utf-8")
+    (root/"kettlejack-package.json").write_bytes(payload)
+    package["package_sha256"]=_sha(payload)
+    return package
+
+
+if __name__=="__main__":
+    import argparse
+    parser=argparse.ArgumentParser(description="Build the Kettlejack animated Game Asset Forge proving character")
+    parser.add_argument("output",type=Path)
+    parser.add_argument("--texture-size",type=int,default=64)
+    parser.add_argument("--height",type=float,default=TARGET_HEIGHT_M)
+    args=parser.parse_args()
+    result=write_kettlejack_package(args.output,texture_size=args.texture_size,target_height_m=args.height)
+    print(json.dumps({
+        "schema":result["schema"],
+        "asset_id":result["asset_id"],
+        "height_m":result["height_m"],
+        "clips":[row["name"] for row in result["clips"]],
+        "primitives":result["delivery"]["primitive_count"],
+        "triangles":result["delivery"]["triangles"],
+        "gltf_sha256":result["delivery"]["gltf_sha256"],
+        "package_sha256":result["package_sha256"],
+        "acceptance":result["acceptance"],
+    },sort_keys=True))
