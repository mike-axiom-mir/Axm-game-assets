+def _accessory_meshes(
+    landmarks: dict[str, tuple[float,float,float]],
+    body: Mesh,
+) -> list[tuple[Mesh, str, str, str]]:
+    """Return mesh, joint name, material family, semantic role."""
+    lo, hi = bounds(body)
+    rows: list[tuple[Mesh,str,str,str]] = []
+    head = landmarks["head"]
+    neck = landmarks["neck"]
+    pelvis = landmarks["pelvis"]
+    left_shoulder = landmarks["left_upper_arm"]
+    right_hand = landmarks["right_hand"]
+    right_shin = landmarks["right_shin"]
+    right_foot = landmarks["right_foot"]
+    left_foot = landmarks["left_foot"]
+
+    rows.append((
+        torus_ring((0.0, neck[1]-.015, neck[2]), radius=.095, tube=.025, axis="y", ratio=.72, major_segments=24, minor_segments=7, name="kettlejack-scarf"),
+        "chest", "scarf", "orange-scarf"
+    ))
+    rows.append((
+        torus_ring((0.0, pelvis[1]+.035, pelvis[2]), radius=.145, tube=.025, axis="y", ratio=.62, major_segments=24, minor_segments=7, name="kettlejack-tool-belt"),
+        "pelvis", "wood", "tool-belt"
+    ))
+
+    front_z = hi[2] + .018
+    for side, dx in (("left",-.055),("right",.055)):
+        rows.append((
+            torus_ring((head[0]+dx, head[1]+.025, front_z), radius=.043, tube=.010, axis="z", major_segments=18, minor_segments=6, name=f"kettlejack-goggle-{side}"),
+            "head", "steel", "goggle-rim"
+        ))
+    rows.append((
+        beam_segment((-.020,head[1]+.025,front_z),(.020,head[1]+.025,front_z),width=.012,depth=.012,name="kettlejack-goggle-bridge"),
+        "head", "steel", "goggle-bridge"
+    ))
+
+    hub = lathe_profile(
+        ((0.0,0.0),(.085,0.0),(.105,.010),(.092,.024),(.055,.032),(0.0,.034)),
+        center=(left_shoulder[0], left_shoulder[1]+.015, hi[2]+.025),
+        axis="z",
+        segments=24,
+        name="kettlejack-hubcap-shoulder",
+    )
+    rows.append((hub, "left_upper_arm", "ivory_metal", "hubcap-shoulder"))
+
+    kettle_center = (0.0, landmarks["chest"][1]-.15, lo[2]-.055)
+    kettle = build_kettle(name="kettlejack-kettle-pack", center=kettle_center, size=.72)
+    family_map = {"salvage_metal":"ivory_metal", "steel":"steel", "wood":"wood"}
+    for part in kettle.parts:
+        rows.append((part.mesh, "chest", family_map.get(part.material_family, "steel"), f"kettle-pack:{part.semantic_role}"))
+
+    shin_x, shin_y, shin_z = right_shin
+    foot_x, foot_y, foot_z = right_foot
+    rows.append((
+        pipe_path(((shin_x,shin_y-.01,shin_z),(foot_x,foot_y+.035,foot_z)),radius=.023,sides=10,name="kettlejack-mech-leg-strut"),
+        "right_shin","steel","mechanical-leg-strut"
+    ))
+    for index in range(6):
+        t=(index+1)/7.0
+        center=(shin_x+(foot_x-shin_x)*t, shin_y+(foot_y-shin_y)*t, shin_z+(foot_z-shin_z)*t)
+        rows.append((
+            torus_ring(center,radius=.055,tube=.010,axis="y",major_segments=18,minor_segments=6,name=f"kettlejack-mech-spring-{index}"),
+            "right_shin","yellow_metal","mechanical-leg-spring"
+        ))
+    rows.append((
+        rounded_box((foot_x, max(.055,foot_y+.015), foot_z+.045),(.16,.09,.25),chamfer=.025,name="kettlejack-mech-foot"),
+        "right_foot","yellow_metal","mechanical-foot"
+    ))
+    rows.append((
+        rounded_box((left_foot[0], max(.055,left_foot[1]+.015), left_foot[2]+.045),(.18,.10,.27),chamfer=.028,name="kettlejack-work-boot"),
+        "left_foot","rubber","heavy-work-boot"
+    ))
+
+    wx, _wy, wz = right_hand
+    shaft_bottom = .08
+    shaft_top = min(hi[1]+.20, 1.46)
+    rows.append((
+        pipe_path(((wx,shaft_bottom,wz+.045),(wx,shaft_top,wz+.045)),radius=.020,sides=8,name="kettlejack-wrench-shaft"),
+        "right_hand","rust_red","wrench-staff-shaft"
+    ))
+    hub_y=shaft_top-.015
+    rows.append((
+        torus_ring((wx,hub_y,wz+.045),radius=.060,tube=.020,axis="z",major_segments=18,minor_segments=6,name="kettlejack-wrench-head-hub"),
+        "right_hand","steel","wrench-head"
+    ))
+    rows.append((
+        beam_segment((wx-.035,hub_y+.025,wz+.045),(wx-.120,hub_y+.115,wz+.045),width=.045,depth=.035,name="kettlejack-wrench-left-jaw"),
+        "right_hand","rust_red","wrench-jaw"
+    ))
+    rows.append((
+        beam_segment((wx+.035,hub_y+.025,wz+.045),(wx+.120,hub_y+.115,wz+.045),width=.045,depth=.035,name="kettlejack-wrench-right-jaw"),
+        "right_hand","rust_red","wrench-jaw"
+    ))
+    return rows
+
